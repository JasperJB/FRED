
#!/usr/bin/env python3
# pt_inference_ai.py - PyTorch inference with pruned model + valid action snapping
import sys
import redis
import time
import numpy as np
import ast
import torch
import torch.nn as nn
import torch.nn.functional as F

print("✅ Inference script launched successfully")

DEBUG = '--debug' in sys.argv

def debug_print(msg):
    if DEBUG:
        print("[DEBUG]", msg, flush=True)

def get_redis_float(rdb, key):
    val = rdb.get(key)
    if val is None:
        debug_print(f"Key '{key}' not found.")
        return None
    try:
        return float(val.decode())
    except Exception as e:
        debug_print(f"Error decoding key '{key}': {e}")
        return None

def get_redis_list(rdb, key):
    val = rdb.get(key)
    if val is None:
        debug_print(f"Key '{key}' not found.")
        return None
    try:
        return ast.literal_eval(val.decode())
    except Exception as e:
        debug_print(f"Error decoding list for key '{key}': {e}")
        return None

class LightweightDualBranchCNN(nn.Module):
    def __init__(self):
        super(LightweightDualBranchCNN, self).__init__()
        self.sensor_fc = nn.Linear(5, 8)
        self.conv1 = nn.Conv2d(1, 8, kernel_size=3, padding=1)
        self.pool = nn.MaxPool2d(2, 2)
        self.conv2 = nn.Conv2d(8, 16, kernel_size=3, padding=1)
        self.fc1 = nn.Linear(16*2*3 + 8, 32)
        self.fc2 = nn.Linear(32, 16)
        self.out = nn.Linear(16, 4)

    def forward(self, sensor_input, cam_input):
        sensor = F.relu(self.sensor_fc(sensor_input))
        x = F.relu(self.conv1(cam_input))
        x = self.pool(x)
        x = F.relu(self.conv2(x))
        x = self.pool(x)
        x = x.view(x.size(0), -1)
        x = torch.cat((x, sensor), dim=1)
        x = F.relu(self.fc1(x))
        x = F.relu(self.fc2(x))
        x = torch.sigmoid(self.out(x))
        return x

def main():
    print("Starting PyTorch AI inference with pruned model")
    time.sleep(2)

    rdb = redis.Redis(host='127.0.0.1', port=6379, db=0)
    model = LightweightDualBranchCNN()
    try:
        model.load_state_dict(torch.load("model_ai_camera_stacked_pruned.pt", map_location="cpu"))
        model.eval()
        debug_print("? Pruned model loaded successfully.")
    except Exception as e:
        print(f"? Failed to load model: {e}", flush=True)
        return

    # Define valid motor commands
    valid_actions = [
        np.array([1, 0, 1, 0]),  # forward
        np.array([0, 1, 0, 1]),  # reverse
        np.array([1, 0, 0, 1]),  # left
        np.array([0, 1, 1, 0])   # right
    ]

    def closest_action(pred):
        return min(valid_actions, key=lambda a: np.linalg.norm(pred - a))

    while True:
        heading = get_redis_float(rdb, "arduino_heading")
        dist1 = get_redis_float(rdb, "arduino_dist1")
        dist2 = get_redis_float(rdb, "arduino_dist2")
        dist3 = get_redis_float(rdb, "arduino_dist3")
        dist4 = get_redis_float(rdb, "arduino_dist4")
        camera_data = get_redis_list(rdb, "camera_depth")

        if None in (heading, dist1, dist2, dist3, dist4) or camera_data is None:
            debug_print("?? Incomplete sensor data; sleeping.")
            time.sleep(0.1)
            continue

        camera_array = np.array(camera_data, dtype=np.float32)
        if camera_array.shape != (9, 12):
            debug_print(f"?? Invalid camera shape: {camera_array.shape}; sleeping.")
            time.sleep(0.1)
            continue

        debug_print(f"Heading: {heading}")
        debug_print(f"Distances: {[dist1, dist2, dist3, dist4]}")
        debug_print(f"Camera min/max: {np.min(camera_array)} / {np.max(camera_array)}")

        sensor_input = torch.tensor([[heading, dist1, dist2, dist3, dist4]], dtype=torch.float32)
        cam_input = torch.tensor(camera_array.reshape(1, 1, 9, 12), dtype=torch.float32)

        with torch.no_grad():
            output = model(sensor_input, cam_input)

        raw_output = output.numpy()[0]
        debug_print(f"Raw output: {raw_output}")

        thresholded = (raw_output >= 0.5).astype(int)
        debug_print(f"Thresholded bits: {thresholded}")

        snapped = closest_action(thresholded)
        debug_print(f"Snapped to valid action: {snapped}")

        motor_bits = snapped
        cmd_str = ",".join(map(str, motor_bits))
        rdb.publish("motor_command", cmd_str)
        rdb.set("motor_state", cmd_str)
        time.sleep(0.1)

if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("\n?? Inference interrupted.")
    except Exception as e:
        print(f"?? Error during inference: {e}")
