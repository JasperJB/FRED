# === Import Libraries ===
import tensorflow as tf
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import tensorflow_model_optimization as tfmot
from sklearn.model_selection import train_test_split
from google.colab import files
import io

print("TensorFlow version:", tf.__version__)

# === Upload CSV ===
uploaded = files.upload()
dfs = [pd.read_csv(io.BytesIO(uploaded[f])) for f in uploaded]
df = pd.concat(dfs, ignore_index=True)
print("Dataset shape:", df.shape)
print(df.head())

# === Preprocess Data ===
other_sensor_cols = ["Heading (0-1)", "Dist1 (cm)", "Dist2 (cm)", "Dist3 (cm)", "Dist4 (cm)"]
camera_cols = [f"Depth_{i}_{j} (0-1)" for i in range(9) for j in range(12)]
motor_cols = ["Motor_IN1", "Motor_IN2", "Motor_IN3", "Motor_IN4"]

X_other = df[other_sensor_cols].to_numpy(dtype=np.float32)
X_cam = df[camera_cols].to_numpy(dtype=np.float32)
X_cam = X_cam.reshape(-1, 9, 12, 1)
y = df[motor_cols].to_numpy(dtype=np.float32)

# === Filter Valid Actions ===
valid_actions = [
    [1, 0, 1, 0],  # forward
    [0, 1, 0, 1],  # reverse
    [1, 0, 0, 1],  # left
    [0, 1, 1, 0]   # right
]
mask = np.any([np.all(y == a, axis=1) for a in valid_actions], axis=0)
X_other = X_other[mask]
X_cam = X_cam[mask]
y = y[mask]

print("\nLabel Frequency Distribution:")
unique, counts = np.unique(y, axis=0, return_counts=True)
for u, c in zip(unique, counts):
    print(f"{u} -> {c} samples")


# === Add Short-Term Memory (stack previous N frames) ===
N = 10  # ← Changed from 5
X_cam_seq = []
X_other_seq = []
y_seq = []

for i in range(N - 1, len(X_cam)):
    X_cam_seq.append(np.concatenate([X_cam[i - j] for j in range(N)][::-1], axis=2))
    X_other_seq.append(np.concatenate([X_other[i - j] for j in range(N)][::-1]))
    y_seq.append(y[i])

X_cam_seq = np.array(X_cam_seq)
X_other_seq = np.array(X_other_seq)
y_seq = np.array(y_seq)

# === Split Data ===
X_other_train, X_other_test, X_cam_train, X_cam_test, y_train, y_test = train_test_split(
    X_other_seq, X_cam_seq, y_seq, test_size=0.2, random_state=42)

# === Define Exact Match Accuracy Metric ===
def exact_match_accuracy(y_true, y_pred):
    y_true = tf.cast(y_true, tf.float32)
    y_pred_bin = tf.cast(y_pred > 0.5, tf.float32)
    matches = tf.reduce_all(tf.equal(y_true, y_pred_bin), axis=1)
    return tf.reduce_mean(tf.cast(matches, tf.float32))

# === Build the Dual-Branch Model ===
input_other = tf.keras.layers.Input(shape=(X_other_train.shape[1],), name="other_input")
# Scale only the heading (first in each block of 5) by 2.0x
scaled_other = tf.keras.layers.Lambda(lambda x: tf.concat([
    tf.concat([x[:, i:i+1] * 2.0, x[:, i+1:i+5]], axis=1) for i in range(0, x.shape[1], 5)
], axis=1))(input_other)
x_other = tf.keras.layers.Dense(32, activation='relu')(scaled_other)

input_cam = tf.keras.layers.Input(shape=(9, 12, X_cam_train.shape[3]), name="cam_input")
x = tf.keras.layers.Conv2D(16, (3, 3), activation='relu', padding='same')(input_cam)
x = tf.keras.layers.MaxPooling2D((2, 2))(x)
x = tf.keras.layers.Conv2D(32, (3, 3), activation='relu', padding='same')(x)
x = tf.keras.layers.MaxPooling2D((2, 2))(x)
x = tf.keras.layers.Flatten()(x)

merged = tf.keras.layers.Concatenate()([x, x_other])

pruning_params = {
    'pruning_schedule': tfmot.sparsity.keras.PolynomialDecay(
        initial_sparsity=0.0,
        final_sparsity=0.5,
        begin_step=0,
        end_step=1000
    )
}

pruned_dense1 = tfmot.sparsity.keras.prune_low_magnitude(
    tf.keras.layers.Dense(64, activation='relu'), **pruning_params)(merged)
pruned_dense2 = tfmot.sparsity.keras.prune_low_magnitude(
    tf.keras.layers.Dense(32, activation='relu'), **pruning_params)(pruned_dense1)
pruned_output = tfmot.sparsity.keras.prune_low_magnitude(
    tf.keras.layers.Dense(4, activation='sigmoid'), **pruning_params)(pruned_dense2)

model = tf.keras.Model(inputs=[input_other, input_cam], outputs=pruned_output)
model.compile(optimizer='adam', loss='binary_crossentropy', metrics=[exact_match_accuracy])
model.summary()

# === Train the Model ===
print("\nInitial Training...")
callbacks = [tfmot.sparsity.keras.UpdatePruningStep()]
history = model.fit(
    [X_other_train, X_cam_train], y_train,
    epochs=30, batch_size=32,
    validation_data=([X_other_test, X_cam_test], y_test),
    callbacks=callbacks,
    verbose=1
)

# === Fine Tuning with Pruning ===
print("\nFine Tuning with Pruning...")
fine_tune_epochs = 5
history_fine = model.fit(
    [X_other_train, X_cam_train], y_train,
    epochs=fine_tune_epochs, batch_size=32,
    validation_data=([X_other_test, X_cam_test], y_test),
    callbacks=callbacks,
    verbose=1
)

# === Evaluate the Model ===
print("\nEvaluating model on test set...")
test_loss, test_acc = model.evaluate([X_other_test, X_cam_test], y_test, verbose=2)
print(f"\nExact Match Test Accuracy: {test_acc * 100:.2f}%")

# === Strip Pruning and Export ===
model_for_export = tfmot.sparsity.keras.strip_pruning(model)
converter = tf.lite.TFLiteConverter.from_keras_model(model_for_export)
tflite_model = converter.convert()
with open("model_ai_camera_stacked.tflite", "wb") as f:
    f.write(tflite_model)
files.download("model_ai_camera_stacked.tflite")
print("TFLite model exported and downloaded.")

